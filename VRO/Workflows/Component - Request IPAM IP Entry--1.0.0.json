            "script": {
                "encoded": false,
                "value": 
                    "
                    import json
                    import requests
                    import urllib3
                    import sys

                    def handler(context, inputs):
                        #jsonOut=json.dumps(inputs, separators=(',', ':'))
                        urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)

                        # Variables
                        hostname = inputs['in_hostname']
                        ipamFQDN = inputs['var_ipamFQDN']
                        ipamAPIVersionNumber = inputs['var_ipamAPIVersionNumber']
                        encryptedToken = inputs['var_encryptedstring']
                        infobloxsubnet = inputs['var_infobloxsubnet']
                        defaultMac = inputs['var_defaultMac']
                        network_view = \"default\"
                        url = f\"https://{ipamFQDN}/wapi/{ipamAPIVersionNumber}/fixedaddress?_return_as_object=1\"

                        # Default statusCode
                        exitCode = 400
                        
                        # REST API Data construction
                        headers = {
                            \"Accept\": \"application/json\",
                            \"Content-Type\": \"application/json\",
                            \"Authorization\": f\"Basic {encryptedToken}\"
                        }

                        payload = { 
                            \"name\": hostname,
                            \"ipv4addr\": f\"func:nextavailableip:{infobloxsubnet}\",
                            \"mac\": f\"{defaultMac}\",
                            \"network_view\": f\"{network_view}\"
                        }

                        # Send message
                        try:
                            response = requests.post( url, headers=headers, json=payload, verify=False )
                            
                            # Check if the request was successful
                            if response.status_code == 201:
                                print( \"Message send successfully!\" )
                                print( \"Response:\", response.json() )
                            else:
                                print( \"Failed to send message.\" )
                                print( \"Status Code:\", response.status_code )
                                print( \"Response:\", response.json() )
                                raise SystemExit(f\"message code not 200, but {response.status_code}\")
                                sys.exit(1)
                            
                            exitCode = response.status_code

                        except Exception as error:
                            print( f\"An error occurred: {error}\" )

                        myArray = response.json()[\"result\"].split(\":\")
                        myArray2 = myArray[-1].split(\"/\")
                        returnedIP = myArray2[0]
                        print(returnedIP)
                        
                        # Return data
                        output = {
                            'out_statusCode': exitCode,
                            'out_responseJSON': response.json(),
                            'out_IP': returnedIP
                        }
                        return output
                    "
            },
            "type": "task"
        },
