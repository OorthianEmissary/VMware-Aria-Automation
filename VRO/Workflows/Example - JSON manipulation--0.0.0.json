            "script": {
                "encoded": false,
                "value": 
                    "
                    /*
                    .SYNOPSIS
                        From workflow that checks if a VM name exists in the vCenter
                    .DESCRIPTION
                        From workflow that checks if a VM name exists in the vCenter
                    .AUTHOR
                        Anders Mikkelsen (github.com/amikkelsendk) og Sølve Holm
                    .CREATION DATE
                        25-09-12
                    */

                    var in_vmName = \"ubuntutest1\"

                    // REST: execute pipeline - Twice
                    try {
                        var restClient = var_vRAHost.createRestClient();
                        var request1 = restClient.createRequest( \"GET\", \"/iaas/api/machines?%24filter=name%2Beq%2B%27\" + in_vmName + \"%27\");
                        var response = restClient.execute( request1 );

                        System.log(\"******Rest Response***** \");
                        var statusCode = response.statusCode;
                        System.log( \"Status code: \" + statusCode );
                        System.log( \"Response1: \" + response.contentAsString );

                        var responsejson = JSON.parse(response.contentAsString);
                        
                        var_outtest = responsejson.content[0];
                        var_outtestArray = responsejson.content;

                        System.log(responsejson.content[0].powerState);
                        System.log(JSON.stringify(responsejson.content[0]));

                        for ( var allocatedIndex in responsejson.content ) {
                            var thisvm = responsejson.content[allocatedIndex];
                            System.log( \"powerstate: \" + thisvm.powerState );
                            }

                        if ( response.statusCode==202 ) {
                            System.log( \"Request accepted\" );
                            var_response1 = JSON.stringify(response);
                        }
                    }
                    catch ( err ) {
                        System.log ( \"***** Failed to run request *****\" );
                        System.error( err );
                    }

                    try {
                        var restClient = var_vRAHost.createRestClient();
                        var request2 = restClient.createRequest( \"GET\", \"/iaas/api/machines?%24filter=name%2Beq%2B%27\" + in_vmName + \".*\" + \"%27\");
                        var response2 = restClient.execute( request2 );

                        System.log(\"******Rest Response2***** \");
                        var statusCode = response2.statusCode;
                        System.log( \"Status code: \" + statusCode );
                    
                        if ( response2.statusCode==202 ) {
                            System.log( \"Request accepted\" );
                            var_response2 = JSON.stringify(response2);
                        }
                    }
                    catch ( err ) {
                        System.log ( \"***** Failed to run request *****\" );
                        System.error( err );
                    }"
            },
