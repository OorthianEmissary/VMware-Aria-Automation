                    "
                    /*
                    .SYNOPSIS
                        Generic example of a REST API POST call to execute a  
                    .DESCRIPTION
                    .AUTHOR
                        Anders Mikkelsen (github.com/amikkelsendk) og Sølve Holm
                    .CREATION DATE
                        25-09-12
                    */

                    // Create Service Broker Catalog Item payload/input
                    var payload = '{ \\
                    \"reason\": null, \\
                    \"deploymentName\": \"vbnvgt\", \\
                    \"projectId\": \"id\", \\
                    \"inputs\": {} \\
                    }'

                    // REST: execute Catalogue Item
                    try {
                        var restClient = var_vRAHost.createRestClient();
                        var request = restClient.createRequest( \"POST\", \"/catalog/api/items/[id]/request\", payload );

                        var response = restClient.execute( request );
                    
                        System.log(\"******Rest Response***** \");
                        var statusCode = response.statusCode;
                        System.log( \"Status code: \" + statusCode );
                    
                        if ( response.statusCode==202 ) {
                            System.log( \"Request accepted\" );
                            System.log( \"Follow/view pipeline execution status in vRA\" );
                        }
                    }
                    catch ( err ) {
                        System.log ( \"***** Failed to run request *****\" );
                        System.error( err );
                    }
                    "
            },
            "type": "task"
        },
