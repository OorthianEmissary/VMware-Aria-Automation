                        var_blueprintID = var_config.getAttributeWithKey(\"key\").value;
                        var_blueprintVersion = var_config.getAttributeWithKey(\"key\").value;
                    }
                    
                    else {
                        throw Error(\"No OS input\");
                    };
                    
                    var_domain = var_config.getAttributeWithKey(\"key\").value;
                    var_hostnameFQDN = in_hostname + \".\" + var_domain;
                    "
