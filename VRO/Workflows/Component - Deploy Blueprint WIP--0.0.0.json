                    "
                    /*
                    .SYNOPSIS
                        Makes a REST API POST call
                    .DESCRIPTION
                        Makes a REST API POST call
                    .AUTHOR
                        Anders Mikkelsen (github.com/amikkelsendk) og Sølve Holm
                    .CREATION DATE
                        25-09-12
                    .NOTES
                        https://domain.net/codestream/api/swagger/webjars/swagger-ui/index.html
                    */
                    
                    //Create pipeline payload/input
                    var payload = {
                    \"projectId\": \"string\",
                    //\"deploymentId\": \"string\",
                    \"deploymentName\": \"string\",
                    \"reason\": \"string\", //Keep as input?
                    //\"description\": \"string\",
                    //\"plan\": true,
                    \"destroy\": false,
                    //\"ignoreDeleteFailures\": true,
                    //\"simulate\": false,
                    \"blueprintId\": var_blueprintID,
                    \"blueprintVersion\": var_blueprintVersion,
                    //\"content\": \"string\",
                    \"inputs\": {
                        \"vmName\": var_hostnameFQDN,
                        \"flavour\": in_flavour,
                        \"os\": in_OU,
                        \"ouFolderName\": \"folder/\" + in_OU,
                        \"owner\": in_owner,
                        \"financialManager\": in_financialManager,
                        \"financialinfo1\": in_financeinfo1,
                        \"financeinfo2\": in_financeinfo2,
                        \"domain\": var_domain,
                        \"IP\": in_IP,
                        \"ticketNr\": in_ticketnumber1
                    }
                    }
                    
                    REST: execute pipeline
                    try {
                        var restClient = var_vRAHost.createRestClient();
                        var request = restClient.createRequest( \"POST\", \"/blueprint/api/blueprints\", payload );
                        var response = restClient.execute( request );
                    
                        System.log(\"******Rest Response***** \");
                        var statusCode = response.statusCode;
                        System.log( \"Status code: \" + statusCode );
                        System.log( \"Response: \" + response.contentAsString );
                    
                        var responsejson = JSON.parse(response.contentAsString);
                        out_response = responsejson.content[0];
                        out_responseArray = responsejson.content;
                    
                        if ( response.statusCode==202 ) {
                            System.log( \"Request accepted\" );
                        }
                    }
                    catch ( err ) {
                        System.log ( \"***** Failed to run request *****\" );
                        System.error( err );
                    }
                    "
