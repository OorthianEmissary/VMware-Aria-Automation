                    "
                    \"\"\"
                    .SYNOPSIS
                        Sends a simple message to a Microsoft Teams Channel using the Webhook webapp url.
                    .DESCRIPTION
                        Sends a simple message to a Microsoft Teams Channel using the Webhook webapp url.
                    .AUTHOR
                    Anders Mikkelsen (github.com/amikkelsendk) og Sølve Holm

                    \"\"\"

                    import json
                    import requests
                    import urllib3

                    def handler(context, inputs):
                        urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)
                        
                        # Create variables
                        headers = {
                            \"Content-Type\": \"application/json\",
                        }

                        payload = { 
                            \"title\": inputs['title'],
                            \"text\": inputs['text'] 
                        }

                        exitCode = 400    # Default statusCode

                        # Send message
                        try:
                            response = requests.post( inputs['var_microsoftTeamsNotificationURL'], json=payload, verify=False )

                            # Check if the request was successful
                            if response.status_code == 200:
                                print( \"Message send successfully!\" )
                                #print( \"Response:\", response.json() )
                            else:
                                print( \"Failed to send message.\" )
                                print( \"Status Code:\", response.status_code )
                                print( \"Response:\", response.json() )
                            
                            exitCode = response.status_code
                        
                        except Exception as e:
                            print( f\"An error occurred: {e}\" )

                        # Return data
                        output = {
                            'statusCode': exitCode
                        }
                        return output
                    "
            },
            "type": "task"
        },
