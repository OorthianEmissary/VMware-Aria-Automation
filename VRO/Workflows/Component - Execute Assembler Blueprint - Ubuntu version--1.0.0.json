            "script": {
                "encoded": false,
                "value": 
                    "
                    /*
                    .SYNOPSIS
                        Makes a call to the assembler blueprint for the ubuntu
                    .DESCRIPTION
                        Makes a call to the assembler blueprint for the ubuntu
                    .AUTHOR
                        Sølve Holm
                        based on code by : Anders Mikkelsen (github.com/amikkelsendk)
                    .CREATION DATE
                        25-09-20:16.15
                    */
                    
                    var payload = '{ \\
                    \"projectId\": \"' + var_projectId + '\", \\
                    \"deploymentId\": \"\", \\
                    \"deploymentName\": \"' + in_vmName + '\", \\
                    \"reason\": \"' + in_reason + '\", \\
                    \"description\": \"' + in_description + '\", \\
                    \"plan\": false, \\
                    \"destroy\": false, \\
                    \"ignoreDeleteFailures\": false, \\
                    \"simulate\": false, \\
                    \"blueprintId\": \"' + var_ubuntuBlueprintID + '\", \\
                    \"blueprintVersion\": \"' + var_UbuntuTargetVersion + '\", \\
                    \"content\": \"\", \\
                    \"inputs\": { \\
                        \"vmName\": \"' + in_vmName + '\", \\
                        \"flavour\": \"' + in_flavour + '\", \\
                        \"os\": \"' + in_os + '\", \\
                        \"ouFolderName\": \"' + in_ouFolderName + '\", \\
                        \"manager\": \"' + in_manager + '\", \\
                        \"owner\": \"' + in_Owner + '\", \\
                        \"financialManager\": \"' + in_financialManager + '\", \\
                        \"financialinfo1\": \"' + in_financialinfo1 + '\", \\
                        \"financialinfo2\": \"' + in_financialinfo2 + '\", \\
                        \"domain\": \"' + in_domain + '\", \\
                        \"IP\": \"' + in_IP + '\", \\
                        \"ticketNr\": \"' + in_ticketNr + '\" \\
                    } \\
                    }' 
                    
                    REST: execute pipeline
                    try {
                        var restClient = var_vRAHost.createRestClient();
                        var request = restClient.createRequest( \"POST\", \"/blueprint/api/blueprint-requests\", payload );
                        var response = restClient.execute( request );
                    
                        System.log(\"******Rest Response***** \");
                        var statusCode = response.statusCode;
                        System.log( \"Status code: \" + statusCode );
                    
                        if ( response.statusCode==202 ) {
                            System.log( \"Request accepted\" );
                            //System.log(response.somethingsomething request ID)
                            System.log( \"Follow/view assembler execution status in vRA\" );
                        }
                    }
                    catch ( err ) {
                        System.log ( \"***** Failed to run request *****\" );
                        System.error( err );
                    }
                    "
            },
            "type": "task"
        },
