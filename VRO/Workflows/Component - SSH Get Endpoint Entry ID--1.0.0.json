                    "
                    \"\"\"
                    .SYNOPSIS
                        Request for SSH ID.
                    .DESCRIPTION
                        Request for SSH ID.
                    .NOTES
                        Author:         Sølve Holm
                        Creation Date:  21-01-2025
                    .Log
                        21-01-2025: Version 1.
                    \"\"\"

                    import json
                    import requests

                    def handler(context, inputs):

                        #Get inputs
                       Token = inputs['var_token']
                        sshurl = inputs['in_sshurl']
                        endpoint = inputs['in_endpoint']

                        # Make payload as dictionary and convert to json
                        payloadDictionary = {
                            \"endpoint\": endpoint
                        }
                        payload = json.dumps(payloadDictionary)

                        # Make headers
                        headers = {
                            'Content-Type': 'application/json; charset=utf-8',
                            'Authorization': f' {token}'
                        }

                        # Make the GET request and print response
                        url = f\"{sshurl}/api/endpoints\"
                        response = requests.request(\"GET\", url, headers=headers, data=payload)
                        #print(response.text)
                        responseMessage = json.loads(response.text)['message']
                        print(f\"RESPONSE MESSAGE: {responseMessage}\")
                        endpointID = \"\"
                        idFound = \"0\"

                        if responseMessage:
                            # Save and output the endpointID
                            endpointID = f\"{json.loads(response.text)['message'][0]['id']}\"
                            print(f\"The Endpoint ID is: {endpointID}\")
                            idFound = \"1\"

                        # Building outputs    
                        outputs = {
                            \"out_endpointId\": endpointID,
                            \"out_idFound\": idFound 
                        }

                        print(f\"Outputs: {outputs}\")

                        return outputs
                        "
            },
