                    if (var_output[0] == \"OK\" && var_output[1] == \"SYSTEMOU_NOT_EXISTS\") {
                    statusCode = \"200\";
                    out_ouExistStatus = \"0\";  The OU does not exists
                    }
                    else if(var_output[0] == \"OK\" && var_output[1] == \"OU_exist\"){
                        statusCode = \"200\";
                        out_ouExistStatus = \"1\";   The OU exists
                    }
                    else {
                        throw new Error('var_output[0] != \"OK\", as expected');
                    }
