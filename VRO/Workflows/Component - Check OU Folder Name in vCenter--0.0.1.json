    {
      "display-name": "API Rest Call POST",
      "script": {
        "value": 
            "/*
            .SYNOPSIS
                Checks vCenter for in_ouFolderName, to check if VM name is already in use.
            .DESCRIPTION
                Checks vCenter for in_ouFolderName, to check if VM name is already in use.
            .AUTHOR
                Anders Mikkelsen (github.com/amikkelsendk) og Sølve Holm.
            .CREATION DATE
                20-10-12
            
            REST: Execute Pipeline
            try {
                var restClient = var_vRAHost.createRestClient();
                System.log(\"****** Checking for OU Folder \" + in_ouFolderName + \" in vCenter *****\");
                var request1 = restClient.createRequest( \"GET\", \"/iaas/api/folders?apiVersion=2021-07-15&%24filter=name%2Beq%2B\" + in_ouFolderName );
                var response = restClient.execute( request1 );
            
                System.log(\"****** Rest Response ***** \");
                var statusCode = response.statusCode;
                System.log( \"Status code: \" + statusCode );
                System.log( \"Response1: \" + response.contentAsString );
            
                var responsejson = JSON.parse(response.contentAsString);
                System.log(\"totalElements: \" + responsejson.numberOfElements );
                var_totalElements = responsejson.numberOfElements;
                
                var_outtest = responsejson.content[0];
                var_outtestArray = responsejson.content;
            
                if ( response.statusCode==202 ) {
                    System.log( \"Request accepted\" );
                    var_response1 = JSON.stringify(response);
                }
            }
            catch ( err ) {
                System.log ( \"***** Failed to run request *****\" );
                System.error( err );
            }
            ",
        "encoded": false
      },
