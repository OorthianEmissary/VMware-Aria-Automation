            "script": {
                "encoded": false,
                "value": 
                    "
                    /*
                    .SYNOPSIS
                        Makes a simple REST API call to the pipelines system and runs a generic pipeline.
                    .DESCRIPTION
                        Makes a simple REST API call to the pipelines system and runs a generic pipeline.
                    .AUTHOR
                    Anders Mikkelsen (github.com/amikkelsendk) og Sølve Holm
                    .CREATION DATE
                        25-09-12
                    */

                    // Create pipeline payload/input

                    var payload = '{ \\
                        \"comments\": \"Executed via API\", \\
                        \"input\": { \\
                            \"text\": \"hello world1234\" \\
                        } \\
                    }'

                    /*var payload2 = '{ \\
                        \"comments\": \"Executed via API\", \\
                        \"input\": {} \\
                    }'*/

                    // REST: execute pipeline
                    try {
                        var restClient = var_vRAHost.createRestClient();
                        var request = restClient.createRequest( \"POST\", \"/codestream/api/pipelines/\"+var_PipelineID+\"/executions\", payload );
                        var response = restClient.execute( request );
                    
                        System.log(\"******Rest Response***** \");
                        var statusCode = response.statusCode;
                        System.log( \"Status code: \" + statusCode );
                        System.log( \"Response: \" + response.contentAsString );

                        var responsejson = JSON.parse(response.contentAsString);
                        System.log(responsejson);
                        var_responseOutPipelineExecution = responsejson;
                        var_pipelineExecutionID = responsejson.executionId;
                        //var_responseOutPipelineExecution = responsejson.content[0];
                        //var_responseOutPipelineExecutionArray = responsejson.content;
                    
                        if ( response.statusCode==202 ) {
                            System.log( \"Request accepted\" );
                            System.log( \"Follow/view pipeline execution status in vRA\" );
                        }
                    }
                    catch ( err ) {
                        System.log ( \"***** Failed to run request *****\" );
                        System.error( err );
                    }
                    "
            },
            "type": "task"
        },
