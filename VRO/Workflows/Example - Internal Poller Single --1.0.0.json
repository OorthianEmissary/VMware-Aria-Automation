                "value": 
                    "
                    /*
                        .SYNOPSIS
                            Example of a polling system.
                        .DESCRIPTION
                            Example of a polling system.
                        .AUTHOR
                            Anders Mikkelsen (github.com/amikkelsendk) og Sølve Holm.
                        .CREATION DATE
                            25-09-12
                        */

                        /*
                        var payload = '{ \\
                            \"comments\": \"Executed via API\", \\
                            \"input\": { \\
                                \"hostname\": \"' + inputProperties.customProperties.HostName + '\", \\
                                \"ip\": \"' + inputProperties.customProperties.IP + '\", \\
                                \"systemOU\": \"' + inputProperties.customProperties.OU + '\", \\
                                \"osType\": \"' + inputProperties.customProperties.osType + '\", \\
                                \"ticketID\": \"' + inputProperties.customProperties.DecomTicketNo + '\" \\
                            } \\
                        }'
                        */

                        try {
                            var restClient = var_vRAHostFromConfigItem.createRestClient();
                            System.log(\"****** Checking WORKFLOW for status *****\");
                            var request = restClient.createRequest( \"GET\", \"/vco/api/workflows/\" + var_workflowId + \"/executions/\" + in_executionID + \"?showDetails=false\" );
                            var response = restClient.execute( request );

                            System.log(\"****** Rest Response ***** \");
                            var statusCode = response.statusCode;
                            System.log( \"Status code: \" + statusCode );
                            System.log( \"Response1: \" + response.contentAsString );

                            var responsejson = JSON.parse( response.contentAsString );
                            
                            //var_outResponse = responsejson.content[0];
                            //var_outResponse = responsejson.content;
                            System.log( \"State of workflow execution: \" + var_workflowId + \" : \" + responsejson.state );
                            var_outResponse = responsejson;
                            var_pollState = responsejson.state;
                            //var_outResponseArray = responsejson.content;
                            //var_outResponseArray = responsejson;

                        /*
                            if ( response.statusCode==202 ) {
                                System.log( \"Request accepted\" );
                                var_response1 = JSON.stringify(response);
                            }
                        */

                        }
                        catch ( err ) {
                            System.log ( \"***** Failed to run request *****\" );
                            System.error( err );
