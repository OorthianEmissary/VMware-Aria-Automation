            "script": {
                "encoded": false,
                "value": 
                    "
                    \"\"\"
                    .SYNOPSIS
                        POST Request for SSH to make entrypoint.
                    .DESCRIPTION
                        POST Request for SSH to make entrypoint.
                    .NOTES
                        Author:         Sølve Holm
                        Creation Date:  21-01-2025
                    \"\"\"

                    import json
                    import requests

                    def handler(context, inputs):
                        
                        #Import inputs
                        Token = inputs['var_token']
                        sshurl = inputs['var_sshurl']
                        description = inputs['in_vmname']
                        endpoint = inputs['in_ip']
                        manager = inputs['in_manager']
                        uuid = inputs['var_vmUuid']
                        organizationalunitfullpath = inputs['in_organizationalunit']
                        organizationalunit = organizationalunitfullpath.split(\"/\")[-1]

                        # Make payload as dictionary and convert to json
                        payloadDictionary = {
                            \"organizationalunit\": organizationalunit,
                            \"endpoint\": endpoint,
                            \"description\": \"VM: \" + description,
                            \"manager\": manager,
                            \"uuid\": uuid
                        }
                        

                        payload = json.dumps(payloadDictionary)

                        # Make headers
                        headers = {
                            'Content-Type': 'application/json; charset=utf-8',
                            'Authorization': f' {token}'
                        }
                        url = f\"{sshurl}/api/endpoints\"
                        
                        # Make the POST request and print response
                        response = requests.request(\"POST\", url, headers=headers, data=payload)
                        print(response.text)
                        
                        outputs = {
                        \"status\": \"done\"
                        }

                        return outputs
                        "
            },
            "type": "task"
        },
