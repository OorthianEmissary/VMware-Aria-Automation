            "script": {
                "encoded": false,
                "value": 
                    "
                    \"\"\"
                    .SYNOPSIS
                        DELETE Request for SSH using entry ID.
                    .DESCRIPTION
                        DELETE Request for SSH using entry ID.
                    .NOTES
                        Author:         Sølve Holm
                        Creation Date:  21-01-2025
                    .Log
                        21-01-2025: Version 1.
                    \"\"\"

                    import json
                    import requests

                    def handler(context, inputs):

                        #Get inputs
                    Token = inputs['var_token']
                        sshurl = inputs['var_sshurl']
                        endpointId = inputs['var_endpointId']
                        
                        # Make payload as dictionary and convert to json
                        payloadDictionary = {
                            \"endpointid\": endpointId
                        }
                        payload = json.dumps(payloadDictionary)

                        # Make headers
                        headers = {
                            'Content-Type': 'application/json; charset=utf-8',
                            'Authorization': f' {token}'
                        }
                        
                        # Make the DELETE request and print response
                        url = f\"{sshurl}/api/endpoints\"
                        response = requests.request(\"DELETE\", url, headers=headers, data=payload)
                        print(response.text)
                        
                        outputs = {
                        \"status\": \"done\"
                        }

                        return outputs
                        "
            },
            "type": "task"
        },
