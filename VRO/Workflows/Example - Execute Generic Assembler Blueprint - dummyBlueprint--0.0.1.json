            "script": {
                "encoded": false,
                "value": 
                    "
                    /*
                    .SYNOPSIS
                        Makes a simple call to a blueprint called \"dummyBlueprint\"
                    .DESCRIPTION
                        Simply used for testing
                    .AUTHOR
                        Sølve Holm
                        based on code by : Anders Mikkelsen (github.com/amikkelsendk)
                    .CREATION DATE
                        25-09-20
                    */

                    // Create pipeline payload/input

                    var payload = '{ \\
                    \"projectId\": \"id\", \\
                    \"deploymentId\": \"\", \\
                    \"deploymentName\": \"' + in_deploymentName + '\", \\
                    \"reason\": \"' + in_reason + '\", \\
                    \"description\": \"' + in_description + '\", \\
                    \"plan\": false, \\
                    \"destroy\": false, \\
                    \"ignoreDeleteFailures\": false, \\
                    \"simulate\": false, \\
                    \"blueprintId\": \"id\", \\
                    \"blueprintVersion\": \"' + var_dummyBlueprintTargetVersion + '\", \\
                    \"content\": \"\", \\
                    \"inputs\": { \\
                        \"customProperty1\": \"' + in_customProperty1 + '\" \\
                    } \\
                    }'

                    // REST: execute pipeline
                    try {
                        var restClient = var_vRAHost.createRestClient();
                        var request = restClient.createRequest( \"POST\", \"/blueprint/api/blueprint-requests\", payload );
                        var response = restClient.execute( request );
                    
                        System.log(\"******Rest Response***** \");
                        var statusCode = response.statusCode;
                        System.log( \"Status code: \" + statusCode );
                    
                        if ( response.statusCode==202 ) {
                            System.log( \"Request accepted\" );
                            System.log( \"Follow/view pipeline execution status in vRA\" );
                        }
                    }
                    catch ( err ) {
                        System.log ( \"***** Failed to run request *****\" );
                        System.error( err );
                    }
                    
                    "
            },
            "type": "task"
        },
